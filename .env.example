TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ADMIN_TELEGRAM_ID=
PARSER_SESSION_NAME=freelance_parser
DATABASE_PATH=./freelance_parser.db
# LLM provider: Groq by default (OpenAI-compatible, free tier).
# The key must match the URL: gsk_... -> api.groq.com, sk-... -> api.openai.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
